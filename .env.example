# Copy to .env for local use. Never commit real values. In Claude Code on the web and GitHub Actions these are
# environment or repository secrets, not files.

# your-store.myshopify.com (not the ornis.shop domain)
SHOPIFY_STORE=
# Admin API token from the "Ornis Operator" app (starts with shpat_). Scopes: docs/HANDOVER.md
SHOPIFY_ADMIN_TOKEN=
# Theme Access password for the Shopify CLI
SHOPIFY_CLI_THEME_TOKEN=

# Optional: smoke test and e2e against the real store
STORE_URL=
PREVIEW_THEME_ID=
STOREFRONT_PASSWORD=
