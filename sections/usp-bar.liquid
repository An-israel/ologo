{%- comment -%} Selling points under the header on every page: free delivery, returns, Klarna, secure checkout. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <style>
    .usp-bar { background: var(--color-surface); border-bottom: 1px solid var(--color-border); }
    .usp-bar__list { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, 1fr); overflow-x: auto; scrollbar-width: none; list-style: none; margin: 0; padding: 0; }
    .usp-bar__list::-webkit-scrollbar { display: none; }
    .usp-bar__item { display: flex; align-items: center; gap: 10px; padding: 10px 12px; min-height: 56px; }
    .usp-bar__item + .usp-bar__item { border-left: 1px solid var(--color-border); }
    .usp-bar__item .icon { width: 26px; height: 26px; color: var(--color-kingfisher); flex: none; }
    .usp-bar__item strong { display: block; font-size: 0.8125rem; line-height: 1.25; }
    .usp-bar__item span { display: block; font-size: 0.75rem; color: var(--color-stone); line-height: 1.3; }
    .usp-bar__item a { color: inherit; text-decoration: none; }
    @media (min-width: 990px) { .usp-bar__list { grid-auto-flow: row; grid-template-columns: repeat({{ section.blocks.size }}, minmax(0, 1fr)); overflow: visible; } .usp-bar__item { justify-content: center; } }
  </style>
  <div class="usp-bar" role="region" aria-label="{{ section.settings.label | escape }}">
    <ul class="usp-bar__list page-width">
      {%- for block in section.blocks -%}
        <li class="usp-bar__item" {{ block.shopify_attributes }}>
          {%- render 'icon', name: block.settings.icon -%}
          <div>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}"><strong>{{ block.settings.title | escape }}</strong></a>{%- else -%}<strong>{{ block.settings.title | escape }}</strong>{%- endif -%}
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Selling points bar",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "label", "label": "Name for screen readers", "default": "Why shop with Ornis" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Selling point",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "delivery", "options": [
          { "value": "delivery", "label": "Delivery" }, { "value": "returns", "label": "Returns" }, { "value": "secure", "label": "Secure payment" }, { "value": "gift", "label": "Gift" }, { "value": "ruler", "label": "Size guide" }
        ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Free UK delivery over £30" },
        { "type": "text", "id": "text", "label": "Small text", "default": "Standard delivery £4.99" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] },
  "presets": [{ "name": "Selling points bar" }]
}
{% endschema %}
