<style>
  #shopify-section-{{ section.id }} .cat-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .cat-grid { grid-template-columns: repeat({{ section.blocks.size | at_most: 6 }}, minmax(0, 1fr)); gap: 16px; } }
  #shopify-section-{{ section.id }} .cat { display: grid; gap: 8px; color: var(--color-ink); text-decoration: none; font-weight: 600; text-align: center; font-size: 0.875rem; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .cat { font-size: 0.9375rem; gap: 10px; } }
  #shopify-section-{{ section.id }} .cat__media { position: relative; aspect-ratio: 1; border-radius: 12px; overflow: hidden; background: #fff; border: 1px solid var(--color-border); transition: box-shadow 200ms ease, border-color 200ms ease; }
  #shopify-section-{{ section.id }} .cat__media img { position: absolute; inset: 8px; width: calc(100% - 16px); height: calc(100% - 16px); object-fit: contain; transition: transform 300ms var(--ease); }
  #shopify-section-{{ section.id }} .cat:hover .cat__media { border-color: var(--color-kingfisher); box-shadow: 0 8px 22px rgba(17, 24, 39, 0.08); }
  #shopify-section-{{ section.id }} .cat:hover .cat__media img { transform: scale(1.04); }
  #shopify-section-{{ section.id }} .cat:hover .cat__label { color: var(--color-kingfisher); }
</style>
<div class="section section--tight">
  <div class="page-width">
    <div class="section-header">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.view_all_link != blank -%}<a class="view-all" href="{{ section.settings.view_all_link }}">{{ 'general.view_all' | t }}<span class="visually-hidden">: {{ section.settings.heading | escape }}</span> {% render 'icon', name: 'chevron-right', class: 'icon--small' %}</a>{%- endif -%}
    </div>
    <ul class="cat-grid">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign tile_image = block.settings.image | default: c.featured_image -%}
        <li {{ block.shopify_attributes }}>
          <a class="cat" href="{{ c.url }}">
            <span class="cat__media">{%- render 'image', image: tile_image, sizes: '(min-width: 750px) 200px, 33vw', widths: '160,240,320,400', alt: '' -%}</span>
            <span class="cat__label">{{ block.settings.title | default: c.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "url", "id": "view_all_link", "label": "View all link", "default": "/collections" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Label", "info": "Uses the collection name if empty." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square photo on a white background, item centred. Uses the collection image if empty." }
      ]
    }
  ],
  "presets": [
    { "name": "Shop by category", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }
  ]
}
{% endschema %}
