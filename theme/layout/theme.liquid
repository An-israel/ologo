<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- render 'favicon' -%}
    {%- render 'meta-tags' -%}

    {{ 'bricolage-grotesque-latin-700-normal.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag: preload: true }}

    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    {%- render 'shop-facts' -%}

    {{ content_for_header }}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>

  <body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">
    <a class="skip-link button button--primary" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {%- render 'newsletter-popup' -%}

    <p id="LiveRegion" class="visually-hidden" aria-live="polite" role="status"></p>

    {%- render 'structured-data-site' -%}
  </body>
</html>
