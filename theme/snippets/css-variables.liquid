{%- liquid
  assign body_font = settings.type_body_font
  assign body_font_bold = body_font | font_modify: 'weight', '600'
-%}
<style>
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}

  @font-face {
    font-family: 'Bricolage Grotesque';
    font-weight: 700;
    font-style: normal;
    font-display: swap;
    src: url('{{ 'bricolage-grotesque-latin-700-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Bricolage Grotesque';
    font-weight: 600;
    font-style: normal;
    font-display: swap;
    src: url('{{ 'bricolage-grotesque-latin-600-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    --color-ink: {{ settings.color_ink }};
    --color-paper: {{ settings.color_paper }};
    --color-kingfisher: {{ settings.color_kingfisher }};
    --color-robin: {{ settings.color_robin }};
    --color-stone: {{ settings.color_stone }};
    --color-plume: {{ settings.color_plume }};
    --color-sand: {{ settings.color_sand }};
    --color-gold: {{ settings.color_gold }};
    --color-border: {{ settings.color_stone | color_modify: 'alpha', 0.3 }};
    --color-ink-rgb: {{ settings.color_ink | color_extract: 'red' }}, {{ settings.color_ink | color_extract: 'green' }}, {{ settings.color_ink | color_extract: 'blue' }};

    --font-heading: 'Bricolage Grotesque', {{ body_font.fallback_families }};
    --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-bold: 600;

    --logo-width: {{ settings.logo_width }}px;
  }
</style>
