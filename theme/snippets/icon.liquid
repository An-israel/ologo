{%- comment -%}
  Outline icons, 1.5px stroke, used only for real functions.
  Usage: {% render 'icon', name: 'search', class: 'icon--small' %}
{%- endcomment -%}
<svg class="icon {{ class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'bag' -%}<path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'chevron-down' -%}<path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-left' -%}<path d="m15 6-6 6 6 6"/>
    {%- when 'chevron-right' -%}<path d="m9 6 6 6-6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'pause' -%}<path d="M9 6v12M15 6v12"/>
    {%- when 'play' -%}<path d="m8 5 11 7-11 7V5Z"/>
    {%- when 'delivery' -%}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'returns' -%}<path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="m8 5-4 4 4 4"/>
    {%- when 'secure' -%}<rect x="5" y="10" width="14" height="10" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    {%- when 'filter' -%}<path d="M4 6h16M7 12h10M10 18h4"/>
    {%- when 'check' -%}<path d="m5 12 5 5 9-10"/>
    {%- when 'info' -%}<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>
    {%- when 'ruler' -%}<path d="M3 16 16 3l5 5L8 21z"/><path d="m7 12 2 2M10 9l2 2M13 6l2 2"/>
    {%- when 'gift' -%}<rect x="3" y="8" width="18" height="4"/><path d="M5 12v9h14v-9M12 8v13M12 8S10 3 7.5 4.5 9 8 12 8Zm0 0s2-5 4.5-3.5S15 8 12 8Z"/>
    {%- when 'instagram' -%}<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".5"/>
    {%- when 'tiktok' -%}<path d="M14 3v12a4 4 0 1 1-4-4"/><path d="M14 3c.5 3 2.5 5 6 5"/>
    {%- when 'facebook' -%}<path d="M15 3h-2a4 4 0 0 0-4 4v3H6v4h3v7h4v-7h3l1-4h-4V7a1 1 0 0 1 1-1h2V3Z"/>
    {%- when 'feather' -%}<path d="M6 20 17 6M6 20l13-8M6 20l6-16"/>
  {%- endcase -%}
</svg>
