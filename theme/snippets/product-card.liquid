{%- comment -%}
  Product card. Params: product, section_id, sizes (image sizes attr), lazy (bool, default true), show_quick_add (bool)
{%- endcomment -%}
{%- liquid
  assign first = product.featured_media
  assign second = product.media[1]
  assign card_sizes = sizes | default: '(min-width: 990px) 25vw, 50vw'
  assign colour_option = null
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'colour' or oname == 'color'
      assign colour_option = option
    endif
  endfor
  assign card_id = section_id | append: '-' | append: product.id
-%}
<div class="card" data-product-id="{{ product.id }}">
  <a class="card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    <div class="media">
      {%- if first -%}
        {%- if lazy == false -%}
          {%- render 'image', image: first.preview_image, sizes: card_sizes, widths: '240,360,480,640,800', loading: 'eager', alt: first.alt -%}
        {%- else -%}
          {%- render 'image', image: first.preview_image, sizes: card_sizes, widths: '240,360,480,640,800', alt: first.alt -%}
        {%- endif -%}
        {%- if second -%}
          {%- render 'image', image: second.preview_image, sizes: card_sizes, widths: '240,360,480,640,800', alt: '' -%}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </a>
  {%- render 'product-badges', product: product -%}
  <div class="card__body">
  <h3 class="card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
  {%- render 'price', product: product, show_from: true -%}
  {%- if colour_option and colour_option.values.size > 1 -%}
    <div class="card__swatches">
      <span class="visually-hidden">{{ 'products.colours_available' | t: count: colour_option.values.size }}:</span>
      {%- for value in colour_option.values limit: 5 -%}
        <span class="card__swatch" style="--swatch: {% render 'swatch-colour', value: value %}" title="{{ value | escape }}"></span>
        <span class="visually-hidden">{{ value | escape }}{% unless forloop.last %},{% endunless %}</span>
      {%- endfor -%}
      {%- if colour_option.values.size > 5 -%}
        <span aria-hidden="true">{%- assign more_count = colour_option.values.size | minus: 5 -%}{{ 'products.more_colours' | t: count: more_count }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}
  </div>
  {%- if show_quick_add and product.available -%}
    <div class="card__quick-add">
      {%- if product.has_only_default_variant -%}
        <product-form>
          {%- form 'product', product, novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="quick-add__button" aria-label="{{ 'products.add_to_bag' | t }}: {{ product.title | escape }}" title="{{ 'products.add_to_bag' | t }}">
              {%- render 'icon', name: 'plus' -%}
            </button>
            <p class="field__error" role="alert" data-form-error-message hidden></p>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <button type="button" class="quick-add__button js-only" data-dialog-open="QuickAdd-{{ card_id }}" aria-label="{{ 'products.quick_add' | t }}: {{ product.title | escape }}" title="{{ 'products.quick_add' | t }}">
          {%- render 'icon', name: 'plus' -%}
        </button>
        <dialog class="modal" id="QuickAdd-{{ card_id }}" aria-labelledby="QuickAddTitle-{{ card_id }}">
          <div class="modal__inner">
            <button type="button" class="icon-button modal__close" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
            <h2 class="h3" id="QuickAddTitle-{{ card_id }}">{{ product.title | escape }}</h2>
            {%- render 'price', product: product -%}
            <product-form>
              {%- form 'product', product, novalidate: 'novalidate' -%}
                <fieldset class="option-group">
                  <legend>{{ 'products.choose_options' | t }}</legend>
                  <div class="option-list">
                    {%- for variant in product.variants -%}
                      <button type="submit" name="id" value="{{ variant.id }}" class="option-pill{% unless variant.available %} is-unavailable{% endunless %}"{% unless variant.available %} disabled{% endunless %}>
                        {{ variant.title | escape }}
                        {%- unless variant.available %}<span class="visually-hidden">, {{ 'accessibility.unavailable_option' | t }}</span>{% endunless -%}
                      </button>
                    {%- endfor -%}
                  </div>
                </fieldset>
                <p class="field__error" role="alert" data-form-error-message hidden></p>
              {%- endform -%}
            </product-form>
            <a href="{{ product.url }}" class="link">{{ 'products.view_details' | t }}<span class="visually-hidden">: {{ product.title | escape }}</span></a>
          </div>
        </dialog>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
