{%- assign looks = product.metafields.custom.complete_the_look.value -%}
{%- if looks != blank -%}
  <div class="section section--tight">
    <div class="page-width">
      <h2>{{ section.settings.heading | escape }}</h2>
      <ul class="scroll-row">
        {%- for item in looks limit: 4 -%}
          {%- if item.available == false -%}{%- continue -%}{%- endif -%}
          <li>{%- render 'product-card', product: item, section_id: section.id, show_quick_add: true -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Complete the look",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look", "info": "Products come from the product's complete_the_look metafield." }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Complete the look" }]
}
{% endschema %}
