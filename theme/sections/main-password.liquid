<style>
  .password { min-height: 100vh; display: grid; place-items: center; background: var(--color-ink); color: var(--color-paper); padding: 32px 16px; text-align: center; }
  .password__inner { max-width: 480px; width: 100%; display: grid; gap: 24px; }
  .password .wordmark { font-size: 2.5rem; }
  .password .input { background: var(--color-paper); color: var(--color-ink); }
  .password a { color: var(--color-paper); }
  .password .form-message--error { text-align: left; }
  .password .muted { color: #c9ccd1; }
</style>
<div class="password on-ink">
  <div class="password__inner">
    <p class="mb-0">{%- render 'wordmark' -%}<span class="visually-hidden">{{ shop.name }}</span></p>
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message | escape }}</p>{%- endif -%}
    {%- render 'newsletter-form', form_id: 'PasswordNewsletter' -%}
    <details>
      <summary class="link">{{ 'templates.password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'stack' -%}
        {%- if form.errors -%}<p class="form-message form-message--error" role="alert" tabindex="-1" data-form-error>{{ 'templates.password.wrong' | t }}</p>{%- endif -%}
        <div class="field">
          <label for="Password">{{ 'templates.password.password' | t }}</label>
          <input class="input" type="password" name="password" id="Password" autocomplete="current-password"{% if form.errors %} aria-invalid="true"{% endif %}>
        </div>
        <button type="submit" class="button button--primary">{{ 'templates.password.enter' | t }}</button>
      {%- endform -%}
      <p class="small muted">{{ 'templates.password.store_owner' | t }} <a href="/admin">{{ 'templates.password.login' | t }}</a></p>
    </details>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }]
}
{% endschema %}
