{%- comment -%} Row of promo cards linking to collections (for example Winter knitwear, Gifts under £15, New in). {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .promo-cards { display: grid; grid-auto-flow: column; grid-auto-columns: 84%; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; list-style: none; padding: 0 0 6px; margin: 0; scrollbar-width: none; }
  #shopify-section-{{ section.id }} .promo-cards::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .promo-cards > li { scroll-snap-align: start; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .promo-cards { grid-auto-flow: row; grid-template-columns: repeat({{ section.blocks.size | at_most: 3 }}, minmax(0, 1fr)); gap: 16px; overflow: visible; } }
  #shopify-section-{{ section.id }} .promo-card { position: relative; display: grid; grid-template-columns: 1fr 44%; align-items: stretch; min-height: 190px; height: 100%; border-radius: 14px; overflow: hidden; text-decoration: none; color: var(--color-ink); border: 1px solid var(--color-border); transition: box-shadow 200ms ease, transform 200ms var(--ease); }
  #shopify-section-{{ section.id }} .promo-card:hover { box-shadow: 0 12px 28px rgba(17, 24, 39, 0.1); transform: translateY(-2px); }
  #shopify-section-{{ section.id }} .promo-card__text { padding: 20px 4px 20px 20px; display: flex; flex-direction: column; gap: 6px; }
  #shopify-section-{{ section.id }} .promo-card__label { align-self: flex-start; padding: 3px 8px; border-radius: 6px; background: var(--color-coral); color: #fff; font-size: 0.75rem; font-weight: 700; }
  #shopify-section-{{ section.id }} .promo-card__title { font-family: var(--font-heading); font-weight: 700; font-size: 1.25rem; line-height: 1.15; letter-spacing: -0.02em; margin: 0; }
  #shopify-section-{{ section.id }} .promo-card__sub { font-size: 0.875rem; color: #374151; margin: 0; }
  #shopify-section-{{ section.id }} .promo-card__cta { margin-top: auto; display: inline-flex; align-items: center; gap: 4px; font-weight: 700; font-size: 0.875rem; color: var(--color-kingfisher); }
  #shopify-section-{{ section.id }} .promo-card__media { position: relative; }
  #shopify-section-{{ section.id }} .promo-card__media img { position: absolute; inset: 12px 12px 12px 0; width: calc(100% - 12px); height: calc(100% - 24px); object-fit: contain; border-radius: 10px; background: #fff; }
</style>
<div class="section section--tight">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<div class="section-header"><h2>{{ section.settings.heading | escape }}</h2></div>{%- endif -%}
    <ul class="promo-cards">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign card_image = block.settings.image | default: c.featured_image -%}
        <li {{ block.shopify_attributes }}>
          <a class="promo-card" href="{{ c.url }}" style="background: var(--color-{{ block.settings.background }})">
            <span class="promo-card__text">
              {%- if block.settings.label != blank -%}<span class="promo-card__label">{{ block.settings.label | escape }}</span>{%- endif -%}
              <span class="promo-card__title">{{ block.settings.title | default: c.title | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="promo-card__sub">{{ block.settings.text | escape }}</span>{%- endif -%}
              <span class="promo-card__cta">{{ section.settings.cta | escape }} {% render 'icon', name: 'chevron-right', class: 'icon--small' %}</span>
            </span>
            <span class="promo-card__media">{%- render 'image', image: card_image, sizes: '(min-width: 750px) 15vw, 40vw', widths: '240,360,480,640', alt: '' -%}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Promo cards",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "text", "id": "cta", "label": "Link text", "default": "Shop now" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Promo card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Uses the collection name if empty." },
        { "type": "text", "id": "text", "label": "Small text" },
        { "type": "text", "id": "label", "label": "Label", "info": "Optional, for example New or Gift idea. Never a discount the item does not really have." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Product on a white background. Uses the collection image if empty." },
        { "type": "select", "id": "background", "label": "Card colour", "default": "mint", "options": [{ "value": "mint", "label": "Light green" }, { "value": "peach", "label": "Light orange" }, { "value": "lilac", "label": "Light lilac" }, { "value": "butter", "label": "Light cream" }, { "value": "sand", "label": "Light pink" }, { "value": "surface", "label": "Light grey" }] }
      ]
    }
  ],
  "presets": [{ "name": "Promo cards", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }]
}
{% endschema %}
