<style>
  #shopify-section-{{ section.id }} .editorial { display: grid; overflow: hidden; border-radius: 28px; background: var(--color-{{ section.settings.background | replace: 'none', 'surface' }}); }
  #shopify-section-{{ section.id }} .editorial__media .media { aspect-ratio: 4 / 3; height: 100%; background: #fff; }
  #shopify-section-{{ section.id }} .editorial__content { padding: 28px 22px 32px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  #shopify-section-{{ section.id }} .editorial__content .rte { font-size: 1.0625rem; color: #374151; margin-bottom: 22px; max-width: 460px; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .editorial { grid-template-columns: 1.1fr 1fr; min-height: 520px; }
    #shopify-section-{{ section.id }} .editorial__media .media { aspect-ratio: auto; position: absolute; inset: 0; }
    #shopify-section-{{ section.id }} .editorial__media { position: relative; min-height: 420px; }
    #shopify-section-{{ section.id }} .editorial--reverse .editorial__media { order: 2; }
    #shopify-section-{{ section.id }} .editorial__content { padding: 56px; }
  }
</style>
<div class="section">
  <div class="page-width">
    <div class="editorial{% if section.settings.reverse %} editorial--reverse{% endif %}">
      <div class="editorial__media">
        <div class="media">
          {%- if section.settings.image != blank -%}
            {%- render 'image', image: section.settings.image, sizes: '(min-width: 750px) 55vw, 100vw', alt: section.settings.image.alt -%}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>
      </div>
      <div class="editorial__content">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a class="button button--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial image and text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Real product photography. No text in the image." },
    { "type": "text", "id": "eyebrow", "label": "Label above the heading", "default": "Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Winter layers" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Knits, fleeces and coats that work hard on cold mornings and still look good by the evening.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop knitwear" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/women" },
    { "type": "checkbox", "id": "reverse", "label": "Image on the right", "default": false },
    { "type": "select", "id": "background", "label": "Background", "default": "lilac", "options": [{"value": "none", "label": "Paper"}, {"value": "mint", "label": "Mint"}, {"value": "peach", "label": "Peach"}, {"value": "lilac", "label": "Lilac"}, {"value": "butter", "label": "Butter"}, {"value": "plume", "label": "Plume"}, {"value": "sand", "label": "Sand"}] }
  ],
  "presets": [{ "name": "Editorial image and text" }]
}
{% endschema %}
