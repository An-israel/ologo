<div class="section">
  <div class="page-width page-width--narrow text-center">
    <h1>{{ 'templates.404.title' | t }}</h1>
    <p>{{ 'templates.404.text' | t }}</p>
    <form action="{{ routes.search_url }}" method="get" role="search" class="inline-form" style="margin: 24px auto; max-width: 480px">
      <label class="visually-hidden" for="NotFoundSearch">{{ 'search.label' | t }}</label>
      <input class="input" type="search" id="NotFoundSearch" name="q" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="button button--primary">{{ 'search.submit' | t }}</button>
    </form>
    {%- render 'popular-collections' -%}
    <p><a href="{{ routes.root_url }}">{{ 'templates.404.back_home' | t }}</a></p>
  </div>
</div>

{% schema %}
{ "name": "404", "settings": [] }
{% endschema %}
