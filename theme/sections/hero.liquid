{%- comment -%}
  Hero: real product photography, live-text heading, one line, one button. Separate mobile and desktop images.
  This image is the LCP element: eager, fetchpriority high, preloaded. Never put text inside the image.
{%- endcomment -%}
{%- liquid
  assign desktop = section.settings.image_desktop
  assign mobile = section.settings.image_mobile | default: desktop
-%}
<style>
  #shopify-section-{{ section.id }} .hero { position: relative; display: grid; background: linear-gradient(135deg, var(--color-peach) 0%, var(--color-butter) 60%, var(--color-mint) 100%); overflow: hidden; }
  #shopify-section-{{ section.id }} .hero::before { content: ''; position: absolute; width: 420px; height: 420px; right: -120px; bottom: -160px; border-radius: 50%; background: var(--color-gold); opacity: 0.35; pointer-events: none; }
  #shopify-section-{{ section.id }} .hero__content { position: relative; }
  #shopify-section-{{ section.id }} .hero__content h1 span { color: var(--color-coral); }
  #shopify-section-{{ section.id }} .hero__media { position: relative; aspect-ratio: 4 / 5; max-height: 52vh; width: 100%; overflow: hidden; }
  #shopify-section-{{ section.id }} .hero__media img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; }
  #shopify-section-{{ section.id }} .hero__content { padding: 24px 16px 32px; }
  #shopify-section-{{ section.id }} .hero__content p { font-size: 1.125rem; }
  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .hero { grid-template-columns: 1fr 1fr; align-items: center; }
    #shopify-section-{{ section.id }} .hero__media { aspect-ratio: 1; max-height: none; }
    #shopify-section-{{ section.id }} .hero__content { padding: 48px; max-width: 560px; }
  }
</style>
{%- if desktop != blank -%}
  {%- comment -%} Preload the right image per viewport so the LCP image starts downloading immediately. {%- endcomment -%}
  <link rel="preload" as="image" media="(max-width: 749px)" fetchpriority="high" imagesrcset="{{ mobile | image_url: width: 480 }} 480w, {{ mobile | image_url: width: 750 }} 750w, {{ mobile | image_url: width: 1100 }} 1100w" imagesizes="100vw">
  <link rel="preload" as="image" media="(min-width: 750px)" fetchpriority="high" imagesrcset="{{ desktop | image_url: width: 750 }} 750w, {{ desktop | image_url: width: 1100 }} 1100w, {{ desktop | image_url: width: 1500 }} 1500w" imagesizes="50vw">
{%- endif -%}
<section class="hero" aria-labelledby="HeroHeading-{{ section.id }}">
  <div class="hero__media">
    {%- if desktop != blank -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ mobile | image_url: width: 480 }} 480w, {{ mobile | image_url: width: 750 }} 750w, {{ mobile | image_url: width: 1100 }} 1100w" sizes="100vw" width="{{ mobile.width }}" height="{{ mobile.height }}">
        {{ desktop | image_url: width: 1500 | image_tag: widths: '750,1100,1500', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: desktop.alt }}
      </picture>
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>
  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1 id="HeroHeading-{{ section.id }}">{{ section.settings.heading | escape }}{% if section.settings.heading_highlight != blank %} <span>{{ section.settings.heading_highlight | escape }}</span>{% endif %}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="button button--{{ section.settings.button_style }}" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image", "info": "Real product photography, at least 1500 px wide. No text in the image." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Portrait 4:5, at least 1100 px wide. Uses the desktop image if empty." },
    { "type": "text", "id": "eyebrow", "label": "Label above the heading", "default": "The Christmas shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Christmas gifts" },
    { "type": "text", "id": "heading_highlight", "label": "Highlighted end of the heading (coral)", "default": "from £10" },
    { "type": "text", "id": "text", "label": "Supporting line", "default": "Jumpers, accessories and stocking fillers, delivered across the UK." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop gifts" },
    { "type": "url", "id": "button_link", "label": "Button link", "default": "/collections/gifts" },
    { "type": "select", "id": "button_style", "label": "Button colour", "default": "accent", "options": [{ "value": "accent", "label": "Marigold" }, { "value": "primary", "label": "Kingfisher" }] }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
