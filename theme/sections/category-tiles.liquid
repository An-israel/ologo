<style>
  #shopify-section-{{ section.id }} .tiles { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; list-style: none; padding: 0; margin: 0; }
  @media (min-width: 750px) { #shopify-section-{{ section.id }} .tiles { grid-template-columns: repeat({{ section.blocks.size | at_most: 5 }}, 1fr); } }
  #shopify-section-{{ section.id }} .tile { display: grid; gap: 8px; color: var(--color-ink); text-decoration: none; font-weight: var(--font-body-weight-bold); font-size: 1.125rem; }
  #shopify-section-{{ section.id }} .tile:hover span { text-decoration: underline; }
</style>
<div class="section">
  <div class="page-width">
    <h2>{{ section.settings.heading | escape }}</h2>
    <ul class="tiles">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign tile_image = block.settings.image | default: c.featured_image -%}
        <li {{ block.shopify_attributes }}>
          <a class="tile" href="{{ c.url }}">
            <div class="media">{%- render 'image', image: tile_image, sizes: '(min-width: 750px) 20vw, 50vw', widths: '240,360,480,640', alt: '' -%}</div>
            <span>{{ block.settings.title | default: c.title | escape }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Label", "info": "Uses the collection name if empty." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Real product photo, 3:4. Uses the collection image if empty." }
      ]
    }
  ],
  "presets": [
    { "name": "Shop by category", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }
  ]
}
{% endschema %}
