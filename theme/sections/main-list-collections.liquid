<div class="section section--tight">
  <div class="page-width">
    <h1>{{ section.settings.heading | escape }}</h1>
    <ul class="grid grid--4">
      {%- for c in collections -%}
        {%- if c.products_count == 0 or c.handle == 'frontpage' or c.handle == 'all' -%}{%- continue -%}{%- endif -%}
        {%- assign img = c.featured_image -%}
        <li>
          <a class="card" href="{{ c.url }}" style="text-decoration: none; color: inherit">
            <div class="media">{%- render 'image', image: img, sizes: '(min-width: 990px) 25vw, 50vw', alt: '' -%}</div>
            <h2 class="h4">{{ c.title | escape }}</h2>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "All collections",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Shop all categories" }]
}
{% endschema %}
