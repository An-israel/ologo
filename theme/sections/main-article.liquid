{%- render 'breadcrumbs' -%}
<article class="section section--tight">
  <div class="page-width page-width--narrow">
    <h1>{{ article.title | escape }}</h1>
    <p class="small muted">{{ article.published_at | time_tag: format: 'date' }}</p>
    {%- if article.image -%}<div class="media media--landscape">{%- render 'image', image: article.image, sizes: '(min-width: 760px) 760px, 100vw', priority: true -%}</div>{%- endif -%}
    <div class="rte" style="margin-top: 24px">{{ article.content }}</div>
  </div>
</article>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
    "author": { "@type": "Organization", "name": {{ shop.name | json }} }
    {%- if article.image -%},"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}
  }
</script>

{% schema %}
{ "name": "Blog post", "settings": [] }
{% endschema %}
