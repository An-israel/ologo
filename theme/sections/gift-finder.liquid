{%- comment -%} Links to automated gift collections (by price and tag). Empty collections are hidden. {%- endcomment -%}
<style>
  #shopify-section-{{ section.id }} .gift-links { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; padding: 0; margin: 0; }
  #shopify-section-{{ section.id }} .gift-links a { border-radius: 999px; border: 0; background: var(--color-gold); color: var(--color-ink); padding-inline: 22px; }
  #shopify-section-{{ section.id }} .gift-links li:nth-child(5n+2) a { background: var(--color-kingfisher); color: var(--color-paper); }
  #shopify-section-{{ section.id }} .gift-links li:nth-child(5n+3) a { background: var(--color-coral); color: var(--color-paper); }
  #shopify-section-{{ section.id }} .gift-links li:nth-child(5n+4) a { background: var(--color-deep); color: var(--color-paper); }
  #shopify-section-{{ section.id }} .gift-links li:nth-child(5n+5) a { background: var(--color-berry); color: var(--color-paper); }
  #shopify-section-{{ section.id }} .gift-links a:hover { filter: brightness(1.08); text-decoration: underline; }
  #shopify-section-{{ section.id }} h2 .icon { display: inline-block; vertical-align: -3px; color: var(--color-coral); }
</style>
<div class="section section--tight section--peach">
  <div class="page-width">
    <h2 class="heading-accent">{% render 'icon', name: 'gift' %} {{ section.settings.heading | escape }}</h2>
    <ul class="gift-links">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- if c == blank or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
        <li {{ block.shopify_attributes }}><a class="button button--secondary" href="{{ c.url }}">{{ block.settings.label | default: c.title | escape }}</a></li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Gift finder",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find a gift" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Gift collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift finder",
      "blocks": [
        { "type": "link", "settings": { "label": "Gifts under £15" } },
        { "type": "link", "settings": { "label": "Gifts under £25" } },
        { "type": "link", "settings": { "label": "For her" } },
        { "type": "link", "settings": { "label": "For him" } },
        { "type": "link", "settings": { "label": "For kids" } }
      ]
    }
  ]
}
{% endschema %}
