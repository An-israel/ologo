{{ 'section-footer.css' | asset_url | stylesheet_tag }}
<footer class="footer on-ink">
  <div class="page-width footer__grid">
    <div class="footer__newsletter">
      <h2 class="h3">{{ section.settings.newsletter_heading | escape }}</h2>
      {%- if settings.newsletter_offer != blank -%}<p>{{ settings.newsletter_offer | escape }}</p>{%- endif -%}
      {%- render 'newsletter-form', form_id: 'FooterNewsletter' -%}
      {%- render 'social-icons' -%}
    </div>
    {%- for i in (1..3) -%}
      {%- liquid
        assign key = 'menu_' | append: i
        assign heading_key = 'menu_heading_' | append: i
        assign menu = linklists[section.settings[key]]
      -%}
      {%- if menu.links.size > 0 -%}
        <nav class="footer__menu" aria-labelledby="FooterMenu-{{ i }}">
          <h2 class="h4" id="FooterMenu-{{ i }}">{{ section.settings[heading_key] | default: menu.title | escape }}</h2>
          <ul class="list-unstyled">
            {%- for link in menu.links -%}
              {%- if link.type == 'collection_link' and link.object.products_count == 0 -%}{%- continue -%}{%- endif -%}
              <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="page-width footer__bottom">
    {%- render 'payment-icons' -%}
    <div class="footer__legal small">
      <p class="mb-0">{%- assign this_year = 'now' | date: '%Y' -%}{{ 'footer.copyright' | t: year: this_year, name: settings.business_name }}{% if settings.legal_name != blank and settings.legal_name != settings.business_name %} ({{ settings.legal_name | escape }}){% endif %}</p>
      {%- if settings.business_address != blank -%}<address class="mb-0">{{ settings.business_address | escape | newline_to_br }}</address>{%- endif -%}
      {%- if settings.business_email != blank -%}<p class="mb-0"><a href="mailto:{{ settings.business_email | escape }}">{{ settings.business_email | escape }}</a></p>{%- endif -%}
      {%- if settings.company_number != blank -%}<p class="mb-0">{{ 'footer.company_number' | t: number: settings.company_number }}</p>{%- endif -%}
      {%- if settings.vat_number != blank -%}<p class="mb-0">{{ 'footer.vat_number' | t: number: settings.vat_number }}</p>{%- endif -%}
      <p class="mb-0"><button type="button" class="link-button footer__cookies" data-cookie-preferences hidden>{{ 'footer.cookie_preferences' | t }}</button></p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Get new arrivals first" },
    { "type": "link_list", "id": "menu_1", "label": "First menu", "default": "footer-shop" },
    { "type": "text", "id": "menu_heading_1", "label": "First menu heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_2", "label": "Second menu", "default": "footer-help" },
    { "type": "text", "id": "menu_heading_2", "label": "Second menu heading", "default": "Help" },
    { "type": "link_list", "id": "menu_3", "label": "Third menu", "default": "footer-about" },
    { "type": "text", "id": "menu_heading_3", "label": "Third menu heading", "default": "About" }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
